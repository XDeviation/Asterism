# Public HTTPS origin, with no trailing slash.
PUBLIC_URL=https://board.example.com

# Generate with `npm run hash-password`; wrap the value in single quotes.
SITE_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$replace-me'

# Independent random values, each at least 32 characters.
SESSION_SECRET=replace-with-a-random-session-secret
BOT_SERVICE_TOKEN=replace-with-the-same-random-token-as-the-bot

# Keep true in production. Set false only for local HTTP development.
COOKIE_SECURE=true

# Trust exactly one reverse-proxy hop. Never use `true` on a public deployment.
TRUST_PROXY=1
