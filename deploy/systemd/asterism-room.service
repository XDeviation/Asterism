[Unit]
Description=Asterism Excalidraw collaboration room
After=network.target

[Service]
Type=simple
User=asterism-room
Group=asterism-room
WorkingDirectory=/opt/asterism/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3002
EnvironmentFile=/etc/asterism/app.env
ExecStart=/usr/bin/env HOST=127.0.0.1 PORT=3002 /usr/bin/node /opt/asterism/current/apps/room/dist/index.js
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=localhost
LimitNOFILE=65536
TasksMax=256
MemoryMax=256M

[Install]
WantedBy=multi-user.target
